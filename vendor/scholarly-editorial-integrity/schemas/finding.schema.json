{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mwm.local/schemas/sei/finding.schema.json",
  "title":"MWM SEI Integrity Finding",
  "type":"object",
  "additionalProperties":false,
  "required":["finding_id","skill_id","chapter_id","version_id","stage","status","risk_level","exact_text","location","claim_or_object","source_or_record","source_access_status","comparison_or_basis","authority","reason","owner","next_action","confidence","escalation","response","closure_condition","created_at","updated_at","release_effect"],
  "properties":{
    "finding_id":{"type":"string","pattern":"^SEI-[A-Za-z0-9._-]+$"},
    "skill_id":{"type":"string","pattern":"^CEI-[0-9]{2}$"},
    "chapter_id":{"type":"string"},
    "version_id":{"type":"string"},
    "stage":{"type":"string","enum":["intake","review","response","production","release","post_publication"]},
    "status":{"type":"string","enum":["verified","supported_with_scope","signal","source_unavailable","disputed","referred","resolved","blocked"]},
    "risk_level":{"type":"string","enum":["low","moderate","high","critical"]},
    "exact_text":{"type":"string"},
    "location":{"type":"object","additionalProperties":false,"required":["locator","context_type"],"properties":{"locator":{"type":"string"},"context_type":{"type":"string","enum":["claim","quote","paraphrase","source","contributor","disclosure","entity","status","AI_event","protected_record","table","figure"]},"page":{"type":["string","null"]}}},
    "claim_or_object":{"type":"string","enum":["claim","quote","paraphrase","source","contributor","disclosure","entity","status","AI_event"]},
    "source_or_record":{"type":"string"},
    "source_access_status":{"type":"string","enum":["local","live","web_only","author_supplied","inaccessible","stale","unknown","not_applicable"]},
    "comparison_or_basis":{"type":"string","minLength":1},
    "authority":{"type":"string","minLength":1},
    "reason":{"type":"string","minLength":1},
    "owner":{"type":"string","minLength":1},
    "next_action":{"type":"string","minLength":1},
    "confidence":{"type":"string","enum":["high","medium","low"]},
    "escalation":{"type":"string","enum":["none","editor","senior_editor","author_group","institution","publisher","legal_or_ethics","security"]},
    "response":{"type":["object","null"],"additionalProperties":false,"required":["received_at","from","summary","evidence_locator"],"properties":{"received_at":{"type":"string"},"from":{"type":"string"},"summary":{"type":"string"},"evidence_locator":{"type":"string"}}},
    "closure_condition":{"type":"string","minLength":1},
    "created_at":{"type":"string"},
    "updated_at":{"type":"string"},
    "release_effect":{"type":"string","enum":["none","track","hold","block"]},
    "dependencies":{"type":"array","items":{"type":"string"}},
    "formal_term_authorization":{"type":["string","null"]}
  }
}
