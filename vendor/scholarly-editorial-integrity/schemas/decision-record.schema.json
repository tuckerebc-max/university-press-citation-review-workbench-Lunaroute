{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mwm.local/schemas/sei/decision-record.schema.json",
  "title":"MWM SEI Integrity Decision",
  "type":"object",
  "additionalProperties":false,
  "required":["decision_id","finding_ids","decision","decision_owner","authority","evidence_considered","response_summary","rationale","release_effect","approved_at","supersedes"],
  "properties":{
    "decision_id":{"type":"string","pattern":"^DEC-SEI-[A-Za-z0-9._-]+$"},
    "finding_ids":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^SEI-[A-Za-z0-9._-]+$"}},
    "decision":{"type":"string","enum":["pass","query","qualify","correct","replace_source","hold","refer","notice","block","no_action"]},
    "decision_owner":{"type":"string","minLength":1},
    "authority":{"type":"string","minLength":1},
    "evidence_considered":{"type":"array","items":{"type":"string"}},
    "response_summary":{"type":"string"},
    "rationale":{"type":"string","minLength":1},
    "release_effect":{"type":"string","enum":["none","track","hold","block"]},
    "approved_at":{"type":"string"},
    "supersedes":{"type":["string","null"]},
    "next_review_trigger":{"type":["string","null"]}
  }
}
