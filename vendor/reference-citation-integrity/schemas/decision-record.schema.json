{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mwm.local/schemas/rci/decision-record.schema.json",
  "title": "MWM RCI Editorial Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_log_id", "decision_hook_id", "status", "question", "alternatives", "evidence_ids", "rationale", "decision_owner", "regression_fixture_ids"],
  "properties": {
    "decision_log_id": {"type": "string", "pattern": "^DEC-RCI-[A-Za-z0-9._-]+$"},
    "decision_hook_id": {"type": "string", "pattern": "^RCI-DH-[0-9]{3}$"},
    "status": {"type": "string", "enum": ["open", "proposed", "approved", "rejected", "superseded"]},
    "question": {"type": "string", "minLength": 1},
    "alternatives": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "description", "consequence"], "properties": {"id": {"type": "string"}, "description": {"type": "string"}, "consequence": {"type": "string"}}}},
    "selected_value": {"type": ["string", "null"]},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "rationale": {"type": "string", "minLength": 1},
    "decision_owner": {"type": "string", "minLength": 1},
    "decided_at": {"type": ["string", "null"]},
    "effective_version": {"type": ["string", "null"]},
    "regression_fixture_ids": {"type": "array", "items": {"type": "string"}}
  }
}
