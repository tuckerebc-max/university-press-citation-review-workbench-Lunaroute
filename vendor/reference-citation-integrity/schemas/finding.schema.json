{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mwm.local/schemas/rci/finding.schema.json",
  "title": "MWM RCI Finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["finding_id", "skill_id", "rule_id", "severity", "status", "action", "confidence", "location", "observed", "evidence", "reason"],
  "properties": {
    "finding_id": {"type": "string", "pattern": "^RCI-[A-Za-z0-9._-]+$"},
    "skill_id": {"type": "string", "pattern": "^RCI-(0[1-7])$"},
    "rule_id": {"type": "string", "pattern": "^RCI-[A-Z0-9-]+$"},
    "severity": {"type": "string", "enum": ["critical", "high", "medium", "low", "informational"]},
    "status": {"type": "string", "enum": ["verified", "informational", "needs_review", "blocked", "not_applicable", "not_checked"]},
    "action": {"type": "string", "enum": ["AUTO_FIX", "SUGGEST", "FLAG", "ESCALATE", "BLOCK", "CLOSE"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "locator", "context_type"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "context_type": {"type": "string", "enum": ["body", "table", "caption", "note", "appendix", "supplementary", "reference_list"]}
      }
    },
    "observed": {"type": "object", "required": ["raw_text"], "properties": {"raw_text": {"type": "string"}, "normalized_value": {}, "source_record_id": {"type": ["string", "null"]}}},
    "expected": {"type": ["object", "null"], "properties": {"value": {}, "rule_profile": {"type": ["string", "null"]}}},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "source_id", "locator", "retrieved_at", "relevance"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "retrieved_at": {"type": ["string", "null"]},
          "relevance": {"type": "string", "minLength": 1}
        }
      }
    },
    "provenance": {"type": "object", "properties": {"source_of_record": {"type": "string"}, "retrievals": {"type": "array"}}},
    "reason": {"type": "string", "minLength": 1},
    "proposed_change": {"type": ["string", "null"]},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "human_decision": {"type": ["object", "null"]},
    "decision_log_id": {"type": ["string", "null"]}
  }
}
