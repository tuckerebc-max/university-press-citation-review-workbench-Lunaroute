{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mwm.local/schemas/rci/regression-intake.schema.json",
  "title": "MWM RCI Regression Intake",
  "type": "object",
  "additionalProperties": false,
  "required": ["intake_id", "reported_at", "source", "stage", "description", "observed_behavior", "expected_behavior", "failure_taxonomy", "severity", "evidence", "disposition"],
  "properties": {
    "intake_id": {"type": "string", "pattern": "^REG-RCI-[A-Za-z0-9._-]+$"},
    "reported_at": {"type": "string", "format": "date-time"},
    "source": {"type": "string", "enum": ["production", "pilot", "editor_review", "proof_review", "evaluation", "audit"]},
    "stage": {"type": "string", "enum": ["intake", "reconciliation", "verification", "rendering", "release", "proof", "handoff"]},
    "run_id": {"type": ["string", "null"]},
    "manuscript_version": {"type": ["string", "null"]},
    "description": {"type": "string", "minLength": 1},
    "observed_behavior": {"type": "string", "minLength": 1},
    "expected_behavior": {"type": "string", "minLength": 1},
    "failure_taxonomy": {"type": "string", "enum": ["extraction", "coverage", "normalization", "reconciliation", "source_classification", "metadata_verification", "identifier_verification", "rule_application", "rendering", "restraint", "escalation", "release_gate", "handoff", "schema", "unknown"]},
    "severity": {"type": "string", "enum": ["critical", "high", "medium", "low", "informational"]},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "locator", "description"], "properties": {"kind": {"type": "string", "enum": ["manuscript", "source", "run_output", "screenshot", "log", "decision_log", "fixture"]}, "locator": {"type": "string"}, "description": {"type": "string"}}}},
    "candidate_rule_ids": {"type": "array", "items": {"type": "string"}},
    "candidate_fixture_id": {"type": ["string", "null"]},
    "reproduction_steps": {"type": "array", "items": {"type": "string"}},
    "containment": {"type": "string"},
    "proposed_change": {"type": ["string", "null"]},
    "disposition": {"type": "string", "enum": ["intake", "reproduced", "not_reproduced", "fixture_added", "rule_change_proposed", "closed", "deferred"]},
    "decision_log_id": {"type": ["string", "null"]}
  }
}
